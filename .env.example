# Get a challenge API key from https://app.gnani.ai/voice
# Keep this file private. The server makes the calls — never put keys in browser JS.
GNANI_API_KEY=
# Optional. Default is ./data
SHOR_DATA_DIR=./data

# Optional access control for a private demo. Keep loopback binding by default.
# HTTP Basic username is shor; use TLS for any remote access.
SHOR_ACCESS_PASSWORD=
SHOR_PUBLIC_MODE=false
SHOR_RETENTION_HOURS=168
SHOR_MAX_RUNS=500
SHOR_REQUESTS_PER_MINUTE=10
# SHOR_DATA_DIR takes precedence over legacy SHORLAB_DATA_DIR when set.
