# Candidate only: not deployed or syntax-validated here; substitute real private-demo
# hostname and operator-provided certificate paths only after deployment approval.
server {
    listen 443 ssl;
    server_name demo.example.invalid;
    ssl_certificate /etc/shor/tls/fullchain.pem;
    ssl_certificate_key /etc/shor/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16m;
    client_body_timeout 15s;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 300s;
        proxy_send_timeout 30s;
    }
}
